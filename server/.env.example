# ── HopperAudit Server ──────────────────────────────────────
# Copy .env.example → .env and fill in real values

# App
APP_NAME=HopperAudit
APP_ENV=development
DEBUG=true

# Database  (PostgreSQL)
DATABASE_URL=postgresql+psycopg://hopper:hopper_pass@localhost:5432/hopperaudit

# JWT Auth
SECRET_KEY=CHANGE-ME-TO-A-RANDOM-SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# S3 / Media storage  (use MinIO locally)
S3_BUCKET_NAME=hopperaudit-media
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000

# AI / YOLO
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.25

# Contamination thresholds
PASS_THRESHOLD=85
HOLD_THRESHOLD=60

# Upload limits
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png
MAX_IMAGES_PER_INSPECTION=5
